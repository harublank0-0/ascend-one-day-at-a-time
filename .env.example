TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=HzRVG_e2TVLT1AgqqKpIMC1j-R_UKq3l
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Postgres Database
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=ascend
DB_PASSWORD=ascend
DB_DATABASE=ascend

# Redis
REDIS_CONNECTION=local
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Mail (development uses Mailpit from docker-compose.yml; the inbox is at http://localhost:8025)
# Other projects often hold 1025 and 8025: change MAILPIT_SMTP_PORT, MAILPIT_UI_PORT and SMTP_PORT together.
MAIL_MAILER=smtp
MAIL_FROM_NAME=Ascend
MAIL_FROM_ADDRESS=no-reply@ascend.localhost
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
